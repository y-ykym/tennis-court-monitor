{
  "name": "tennis-booking-assist",
  "version": "0.1.0",
  "private": true,
  "description": "フェーズ2 予約支援(半自動予約)。LINEの「予約する」ボタンから予約直前画面まで自動遷移し、reCAPTCHAと確定だけ人間が行う",
  "type": "module",
  "scripts": {
    "reserve": "node scripts/reserve-cli.mjs",
    "explore": "node scripts/explore-flow.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:novnc": "esbuild node_modules/@novnc/novnc/lib/rfb.js --bundle --format=esm --minify --outfile=server/public/rfb.js",
    "server": "node server/server.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@novnc/novnc": "^1.5.0",
    "playwright": "^1.62.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
