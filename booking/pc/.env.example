# 自宅 PC 用の設定。cp .env.example .env してから値を埋める(.env は gitignore 済み。共有しない)

# --- 予約サイトの利用者番号・パスワード・呼び名(A は必須、B は任意) ---
SITE_USER_A=
SITE_PASS_A=
LABEL_A=
SITE_USER_B=
SITE_PASS_B=
LABEL_B=

# --- 署名鍵。GitHub Secrets の BOOKING_SIGNING_SECRET、Worker の Secret と同じ値 ---
BOOKING_SIGNING_SECRET=

# --- 玄関の Worker(URL 登録先) ---
WORKER_URL=https://tennis-reservation-bot.y-ykym.workers.dev

# --- 予約結果を LINE に push する(任意。GitHub Secrets と同じ値) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# --- noVNC のパスワード(任意。空なら起動ごとに乱数) ---
VNC_PASSWORD=
