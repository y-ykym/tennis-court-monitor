# 自宅 PC 用の設定。cp .env.example .env してから値を埋める(.env は gitignore 済み。共有しない)

# --- 予約サイトの利用者番号・パスワード・呼び名(A は必須、B は任意) ---
SITE_USER_A=
SITE_PASS_A=
LABEL_A=
SITE_USER_B=
SITE_PASS_B=
LABEL_B=

# --- 署名鍵。GitHub Secrets の BOOKING_SIGNING_SECRET、Worker の Secret と同じ値 ---
BOOKING_SIGNING_SECRET=

# --- 玄関の Worker(URL 登録先) ---
WORKER_URL=https://tennis-reservation-bot.y-ykym.workers.dev

# --- 予約結果を LINE に push する(任意。GitHub Secrets と同じ値) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# --- noVNC のパスワード(任意。空なら起動ごとに乱数) ---
VNC_PASSWORD=

# --- フェーズ3 自動予約(src/auto-runner.js) ---
#   off      照会ループを起動しない(既定)
#   dry-run  1 分おきに空きを照会して振り分けをログに出す。予約はしない。Worker には「生存・自動予約は停止中」と合図(Actions は従来どおり全部通知)
#   on       予約まで行う(Actions は自動予約の対象の枠を通知しなくなる)
AUTO_BOOKING=off
# 照会間隔(ミリ秒。既定 60000。30000 未満は 30000 に切り上げ)
# AUTO_POLL_MS=60000
