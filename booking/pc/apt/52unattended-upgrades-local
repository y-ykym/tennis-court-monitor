// Raspberry Pi(homepi)の自動更新方針(2026-09-13 決定)。pi-init.sh §7 が /etc/apt/apt.conf.d/ に置く。
// 「OS・カーネル・Docker を毎朝 4 時に自動で更新し、再起動が必要なら 4:30 に再起動する」。
//
//   入れる: Debian(通常・updates・security)、Raspberry Pi のカーネル/ファームウェア(archive.raspberrypi.com)、Docker(download.docker.com)
//           Docker の更新でコンテナは 20〜30 秒再起動する。4 時台に予約ボタンを押すことは無い前提で受け入れる(利用者判断)
//   再起動: /var/run/reboot-required ができていれば 04:30 に無条件で再起動(ログイン中でも)。予約処理中かどうかは見ない
//   時刻:   apt-daily-upgrade.timer を 04:00(±10 分)に変更している(systemd/apt-daily-upgrade-override.conf)。
//           既定の 06:00 だと再起動が翌日の 04:30 まで持ち越されるため
//   入らないもの: 予約サイトを開くブラウザ(Chromium)は Docker イメージの中なので、apt では更新されない。
//           数か月に 1 回 `docker compose build --pull` で入れ直す(月初に LINE でお知らせが届く。README §8)
//
// 確認: sudo unattended-upgrade --dry-run --debug   /  ログ: /var/log/unattended-upgrades/

// 既定(50unattended-upgrades)の一覧は「足し合わせ」になるので、いったん空にしてから書く
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,codename=${distro_codename},label=Debian";
    "origin=Debian,codename=${distro_codename}-updates,label=Debian";
    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
    "origin=Raspberry Pi Foundation,label=Raspberry Pi Foundation";
    "origin=Docker,label=Docker CE";
};

Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "04:30";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::MinimalSteps "true";
// メール送信の仕組みは無いので通知は使わない。結果はログと pi-check.sh で見る
Unattended-Upgrade::Mail "";
